{
    "position": "top",

    "margin-top": 7,
    "margin-left": 5,
    "margin-right": 5,

    "modules-left": [
        "hyprland/workspaces",
        "temperature",
        "battery"
        // "custom/media"
    ],

    "modules-center": [
        "clock",
        "power-profiles-daemon",
    ],

    "modules-right": [
        "tray",
        "memory",
        "cpu",
        "wireplumber",
        "backlight",
        "custom/power"
    ],

    // -------------------------------------------------------------------------
    // Modules
    // -------------------------------------------------------------------------

    "temperature": {
        "interval": 5,
        "tooltip": false,
        "critical-threshold": 80,
        "format": "{icon}  {temperatureC}",
        "format-icons": [""],
        "max-length": 6,
        "min-length": 6
    },

    "memory": {
        "interval": 30,
        "format": "  {used:0.2f} GB",
        "tooltip-format": "{used:0.2f} GB / {total:0.2f} GB",
        "min-length": 11,
        "max-length": 11
    },

    "battery": {
        "interval": 10,
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon}  {capacity}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "max-length": 6,
        "min-length": 6
    },

    "backlight": {
        "format": "{icon}  {percent}",
        "format-icons": ["", ""],
        "on-scroll-down": "brightnessctl s 5%-",
        "on-scroll-up": "brightnessctl s +5%",
        "tooltip": false,
        "min-length": 6,
        "max-length": 6
    },

    "custom/media": {
        "format": "🎜 {}",
        "tooltip-format": "{}",
        "return-type": "json",
        "hide-on-empty": false,
        "max-length": 20,
        "min-length": 20,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null"
    },

    "custom/power": {
        "format": " ",
        "tooltip": false,
        "on-click": "wlogout"
    },

    "clock": {
        "format": "❤️ {:%H:%M    %a, %B %d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "today-format": "{}",
    },

    "cpu": {
        "interval": 5,
        "format": "  {avg_frequency:0.2f} GHz",
        "max-length": 11,
        "min-length": 11
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch workspace e+1 1>/dev/null",
        "on-scroll-down": "hyprctl dispatch workspace e-1 1>/dev/null",
        "sort-by-number": true,
        "active-only": false,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "wireplumber": {
        "on-click": "pavucontrol",
        "on-click-right": "amixer sset Master toggle 1>/dev/null",
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "default": [" ", " ", " "]
        },
        "min-length": 2,
        "max-length": 2,
        "tooltip": false
    },

    "tray": {
        "icon-size": 15,
        "spacing": 15
    },

    "power-profiles-daemon": {
        "format": " {icon} ",
        "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
        "tooltip": true,
        "format-icons": {
            "default": "",
            "performance": " ",
            "balanced": " ",
            "power-saver": " "
        }
    }
}
